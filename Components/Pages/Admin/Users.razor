@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Lab5_Identity.Data

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Управление пользователями</PageTitle>

<h1>Управление пользователями</h1>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Имя пользователя</th>
                    <th>Email</th>
                    <th>Роли</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Id.Substring(0, 8)...</td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                            @if (!user.Roles.Any())
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditUserRoles(user.Id)">
                                Управление ролями
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showRolesModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Управление ролями: @editingUserName</h5>
                    <button type="button" class="btn-close" @onclick="CloseRolesModal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Email:</strong> @editingUserEmail</p>
                    <div class="mb-3">
                        <label class="form-label">Роли:</label>
                        @foreach (var role in availableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       checked="@(selectedRoles.Contains(role))"
                                       @onchange="@(() => ToggleRole(role))" />
                                <label class="form-check-label">@role</label>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert @(statusMessageType == "success" ? "alert-success" : "alert-danger") mt-3">
                            @statusMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRolesModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUserRoles" disabled="@isProcessing">
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserViewModel> users = [];
    private List<string> availableRoles = [];
    private bool isLoading = true;
    private bool showRolesModal = false;
    private string? editingUserId;
    private string editingUserName = "";
    private string editingUserEmail = "";
    private HashSet<string> selectedRoles = [];
    private HashSet<string> originalRoles = [];
    private bool isProcessing = false;
    private string statusMessage = "";
    private string statusMessageType = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Загружаем роли
            availableRoles = (await RoleManager.Roles.Select(r => r.Name!).ToListAsync())
                .Where(r => r != null)
                .ToList();

            // Загружаем пользователей с их ролями
            var dbUsers = await DbContext.Users.ToListAsync();
            users = new List<UserViewModel>();

            foreach (var user in dbUsers)
            {
                var userRoles = await UserManager.GetRolesAsync(user);
                users.Add(new UserViewModel
                {
                    Id = user.Id,
                    UserName = user.UserName ?? "",
                    Email = user.Email ?? "",
                    Roles = userRoles.ToList()
                });
            }
        }
        catch
        {
            users = [];
            availableRoles = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EditUserRoles(string userId)
    {
        editingUserId = userId;
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            editingUserName = user.UserName ?? "";
            editingUserEmail = user.Email ?? "";
            var roles = await UserManager.GetRolesAsync(user);
            selectedRoles = roles.ToHashSet();
            originalRoles = roles.ToHashSet();
            showRolesModal = true;
            statusMessage = "";
        }
    }

    private void ToggleRole(string role)
    {
        if (selectedRoles.Contains(role))
        {
            selectedRoles.Remove(role);
        }
        else
        {
            selectedRoles.Add(role);
        }
    }

    private async Task SaveUserRoles()
    {
        if (editingUserId == null) return;

        isProcessing = true;
        statusMessage = "";

        try
        {
            var user = await UserManager.FindByIdAsync(editingUserId);
            if (user == null)
            {
                statusMessageType = "danger";
                statusMessage = "Пользователь не найден";
                return;
            }

            // Удаляем роли, которые были сняты
            var rolesToRemove = originalRoles.Except(selectedRoles).ToList();
            if (rolesToRemove.Any())
            {
                await UserManager.RemoveFromRolesAsync(user, rolesToRemove);
            }

            // Добавляем новые роли
            var rolesToAdd = selectedRoles.Except(originalRoles).ToList();
            if (rolesToAdd.Any())
            {
                await UserManager.AddToRolesAsync(user, rolesToAdd);
            }

            statusMessageType = "success";
            statusMessage = "Роли успешно обновлены!";
            
            await LoadData();
            
            await Task.Delay(1500);
            CloseRolesModal();
        }
        catch (Exception ex)
        {
            statusMessageType = "danger";
            statusMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CloseRolesModal()
    {
        showRolesModal = false;
        editingUserId = null;
        editingUserName = "";
        editingUserEmail = "";
        selectedRoles.Clear();
        originalRoles.Clear();
        statusMessage = "";
    }

    private class UserViewModel
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public List<string> Roles { get; set; } = [];
    }
}
