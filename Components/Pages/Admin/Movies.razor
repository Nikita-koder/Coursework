@page "/admin/movies"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Lab5_Identity.Data

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Управление фильмами</PageTitle>

<h1>Управление фильмами</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowAddMovieModal">
        <span class="bi bi-plus-circle"></span> Добавить фильм
    </button>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Длительность</th>
                    <th>Возрастной рейтинг</th>
                    <th>Дата выхода</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in movies)
                {
                    <tr>
                        <td>@movie.MovieId</td>
                        <td>@movie.Title</td>
                        <td>@movie.DurationMinutes мин</td>
                        <td>@(movie.AgeRating ?? "—")</td>
                        <td>@(movie.ReleaseDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>
                            @if (movie.IsActive)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Неактивен</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditMovie(movie)">
                                Редактировать
                            </button>
                            @if (movie.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleMovieStatus(movie.MovieId)">
                                    Деактивировать
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleMovieStatus(movie.MovieId)">
                                    Активировать
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingMovie == null ? "Добавить фильм" : "Редактировать фильм")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@movieForm" OnValidSubmit="@SaveMovie">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Название *</label>
                            <InputText class="form-control" @bind-Value="movieForm.Title" />
                            <ValidationMessage For="@(() => movieForm.Title)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Описание</label>
                            <InputTextArea class="form-control" @bind-Value="movieForm.Description" rows="3" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Длительность (минуты) *</label>
                                <InputNumber class="form-control" @bind-Value="movieForm.DurationMinutes" />
                                <ValidationMessage For="@(() => movieForm.DurationMinutes)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Возрастной рейтинг</label>
                                <InputText class="form-control" @bind-Value="movieForm.AgeRating" placeholder="6+, 12+, 16+, 18+" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Дата выхода</label>
                            <InputDate class="form-control" @bind-Value="movieForm.ReleaseDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">URL постера</label>
                            <InputText class="form-control" @bind-Value="movieForm.PosterUrl" placeholder="https://..." />
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="movieForm.IsActive" />
                            <label class="form-check-label">Активен</label>
                        </div>
                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="alert @(statusMessageType == "success" ? "alert-success" : "alert-danger") mt-3">
                                @statusMessage
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                        <button type="submit" class="btn btn-primary" disabled="@isProcessing">Сохранить</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Movie> movies = [];
    private bool isLoading = true;
    private bool showModal = false;
    private Movie? editingMovie;
    private bool isProcessing = false;
    private string statusMessage = "";
    private string statusMessageType = "";

    private MovieForm movieForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMovies();
    }

    private async Task LoadMovies()
    {
        isLoading = true;
        try
        {
            movies = await DbContext.Movies
                .OrderBy(m => m.Title)
                .ToListAsync();
        }
        catch
        {
            movies = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddMovieModal()
    {
        editingMovie = null;
        movieForm = new MovieForm { IsActive = true };
        showModal = true;
        statusMessage = "";
    }

    private void EditMovie(Movie movie)
    {
        editingMovie = movie;
        movieForm = new MovieForm
        {
            Title = movie.Title,
            Description = movie.Description ?? "",
            DurationMinutes = movie.DurationMinutes,
            AgeRating = movie.AgeRating ?? "",
            ReleaseDate = movie.ReleaseDate,
            PosterUrl = movie.PosterUrl ?? "",
            IsActive = movie.IsActive
        };
        showModal = true;
        statusMessage = "";
    }

    private async Task SaveMovie()
    {
        isProcessing = true;
        statusMessage = "";
        
        try
        {
            if (editingMovie == null)
            {
                // Добавляем новый фильм
                var newMovie = new Movie
                {
                    Title = movieForm.Title,
                    Description = movieForm.Description,
                    DurationMinutes = movieForm.DurationMinutes,
                    AgeRating = string.IsNullOrWhiteSpace(movieForm.AgeRating) ? null : movieForm.AgeRating,
                    ReleaseDate = movieForm.ReleaseDate,
                    PosterUrl = string.IsNullOrWhiteSpace(movieForm.PosterUrl) ? null : movieForm.PosterUrl,
                    IsActive = movieForm.IsActive
                };
                DbContext.Movies.Add(newMovie);
            }
            else
            {
                // Обновляем существующий фильм
                editingMovie.Title = movieForm.Title;
                editingMovie.Description = movieForm.Description;
                editingMovie.DurationMinutes = movieForm.DurationMinutes;
                editingMovie.AgeRating = string.IsNullOrWhiteSpace(movieForm.AgeRating) ? null : movieForm.AgeRating;
                editingMovie.ReleaseDate = movieForm.ReleaseDate;
                editingMovie.PosterUrl = string.IsNullOrWhiteSpace(movieForm.PosterUrl) ? null : movieForm.PosterUrl;
                editingMovie.IsActive = movieForm.IsActive;
            }

            await DbContext.SaveChangesAsync();
            statusMessageType = "success";
            statusMessage = editingMovie == null ? "Фильм успешно добавлен!" : "Фильм успешно обновлён!";
            
            await LoadMovies();
            
            await Task.Delay(1500);
            CloseModal();
        }
        catch (Exception ex)
        {
            statusMessageType = "danger";
            statusMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleMovieStatus(int movieId)
    {
        try
        {
            var movie = await DbContext.Movies.FindAsync(movieId);
            if (movie != null)
            {
                movie.IsActive = !movie.IsActive;
                await DbContext.SaveChangesAsync();
                await LoadMovies();
            }
        }
        catch
        {
            // Обработка ошибки
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editingMovie = null;
        movieForm = new();
        statusMessage = "";
    }

    private class MovieForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Название обязательно")]
        [System.ComponentModel.DataAnnotations.StringLength(256)]
        public string Title { get; set; } = "";

        public string Description { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Длительность обязательна")]
        [System.ComponentModel.DataAnnotations.Range(1, 600, ErrorMessage = "Длительность должна быть от 1 до 600 минут")]
        public int DurationMinutes { get; set; }

        public string AgeRating { get; set; } = "";

        public DateTime? ReleaseDate { get; set; }

        public string PosterUrl { get; set; } = "";

        public bool IsActive { get; set; } = true;
    }
}
